# 填入 Key 后，把 mock 改为 glm；留空时不会偷偷回退或发真实请求。
AGENT_MODE=mock
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
# 若你使用其他兼容网关或套餐，请改成对应的 Chat Completions base URL。
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_TURNS=10
MAX_TOTAL_TOKENS=30000
MAX_CONTEXT_CHARS=60000
# 同一轮内只读工具的并行度（1 为串行）；工具超时防单个调用拖垮整批。
MAX_PARALLEL_TOOLS=3
TOOL_TIMEOUT_SECONDS=20
RUN_TIMEOUT_SECONDS=120
MAX_CONCURRENT_RUNS=2
# 服务默认只监听 127.0.0.1。若暴露到其他网络，必须配置鉴权和 TLS。
# 配置后所有 /runs、/sessions 接口需 Authorization: Bearer <token>。
AGENT_SERVICE_TOKEN=
# 可选路径；相对路径总是基于 my_agent，而不是命令的工作目录。
CORPUS_DIR=data/corpus
AGENT_DB_PATH=data/agent.sqlite3
